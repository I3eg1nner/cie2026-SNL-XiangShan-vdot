work/
**/build/
**/out/
*.o
*.so
*.a
*.vcd
*.fst
*.fsdb
.DS_Store
__pycache__/

# 本地编译产物
tests/golden/*.o
tests/golden/test_golden
tests/golden/vdot_cli
*.dSYM/
