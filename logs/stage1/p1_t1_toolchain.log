cc    -c -o prtime.o prtime.c
cc    -c -o reduce.o reduce.c
cc    -c -o rows.o rows.c
cc    -c -o set.o set.c
cc    -c -o setc.o setc.c
cc    -c -o sharp.o sharp.c
cc    -c -o sigma.o sigma.c
