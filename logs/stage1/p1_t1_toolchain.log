cc    -c -o signature.o signature.c
cc    -c -o sminterf.o sminterf.c
cc    -c -o solution.o solution.c
cc    -c -o sparse.o sparse.c
cc    -c -o strdup.o strdup.c
cc    -c -o unate.o unate.c
cc    -c -o util_signature.o util_signature.c
cc    -c -o verify.o verify.c
cc     black_white.o canonical.o cofactor.o cols.o compl.o contain.o cpu_time.o cubestr.o cvrin.o cvrm.o cvrmisc.o cvrout.o dominate.o equiv.o espresso.o essen.o essentiality.o exact.o expand.o gasp.o gimpel.o globals.o hack.o indep.o irred.o main.o map.o matrix.o mincov.o opo.o pair.o part.o primes.o prtime.o reduce.o rows.o set.o setc.o sharp.o sigma.o signature_exact.o signature.o sminterf.o solution.o sparse.o strdup.o unate.o util_signature.o verify.o -o ../bin/espresso
exit=

