      $var wire 64 Q#! src_data_vec_1_REG [63:0] $end
      $var wire 64 V%! prev_data_vec_1_REG [63:0] $end
      $var wire 1 yr ta_reg $end
      $var wire 5 P"! elem_vld_reg [4:0] $end
     $upscope $end
    $upscope $end
   $upscope $end
  $upscope $end
 $upscope $end
$enddefinitions $end


