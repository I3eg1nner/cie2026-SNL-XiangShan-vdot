+// ---------------------------------------------------------------------------
+// 定向语料回放：读取 tests/vectors/*.txt（格式见 docs/stage2/13 §3.1）
+//   op vsew vstart vl vm vta vma vs1_hex vs2_hex vd_in_hex vd_expected_hex v0_hex status
+// 只取输入字段，期望值仍由 golden model 现场算，从而同时校验 RTL 与语料文件。
+// status != OK 的用例（例如归约类 vstart!=0 的 ILLEGAL_VSTART）在 FU 级平台无法建模异常，
+// 直接跳过并统计条数。
+// ---------------------------------------------------------------------------
+static int vdot_hexpair(const char *s, uint64_t out[2]) {
+  out[0] = 0; out[1] = 0;
+  for (int i = 0; i < 16; i++) {
+    int v = 0;
+    for (int k = 0; k < 2; k++) {
+      char c = s[2*i+k];
+      int d;
+      if (c >= '0' && c <= '9') d = c - '0';
+      else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
+      else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
+      else return -1;
+      v = (v << 4) | d;
+    }
+    out[i / 8] |= ((uint64_t)(uint8_t)v) << (8 * (i % 8));
+  }
+  return 0;
+}
+
+void TestDriver::load_vdot_vectors(const char *path) {
+  FILE *f = fopen(path, "r");
+  if (f == NULL) { printf("[vdot-vectors] cannot open %s\n", path); exit(1); }
+  char line[1024];
+  char op[32], vs1h[64], vs2h[64], vdh[64], vdeh[64], v0h[64], st[32];
+  int vsew, vstart, vl, vm, vta, vma;
+  long skipped = 0, bad = 0;
+  while (fgets(line, sizeof(line), f) != NULL) {
+    if (line[0] == '#' || line[0] == '\n' || line[0] == '\r') continue;
+    int n = sscanf(line, "%31s %d %d %d %d %d %d %63s %63s %63s %63s %63s %31s",
+                   op, &vsew, &vstart, &vl, &vm, &vta, &vma,
+                   vs1h, vs2h, vdh, vdeh, v0h, st);
+    if (n != 13) { bad++; continue; }
+    if (strcmp(st, "OK") != 0) { skipped++; continue; }
+    VecInput c;
+    memset(&c, 0, sizeof(c));
+    c.fuType = VDot;
+    if      (strcmp(op, "vdot")    == 0) c.fuOpType = VDOT_VV;
+    else if (strcmp(op, "vdotacc") == 0) c.fuOpType = VDOTACC_VV;
+    else if (strcmp(op, "vdot4a")  == 0) c.fuOpType = VDOT4A_VV;
+    else { bad++; continue; }
+    c.sew = (c.fuOpType == VDOT4A_VV) ? 2 : 0;
+    // 语料里的 vs2/vs1 对应 DUT 的 src(0)/src(1)，即 C++ 的 src1/src2
+    if (vdot_hexpair(vs2h, c.src1) || vdot_hexpair(vs1h, c.src2) ||
+        vdot_hexpair(vdh,  c.src3) || vdot_hexpair(v0h,  c.src4)) { bad++; continue; }
+    c.vinfo.vstart = (uint8_t)vstart;
+    c.vinfo.vl     = (uint8_t)vl;
+    c.vinfo.vlmul  = 0;   // LMUL = 1（裁定 S-6）
+    c.vinfo.vm     = vm != 0;
+    c.vinfo.ta     = vta != 0;
+    c.vinfo.ma     = vma != 0;
+    vec_cases.push_back(c);
+  }
+  fclose(f);
+  printf("[vdot-vectors] loaded %zu cases from %s (skipped %ld non-OK, %ld unparsed)\n",
+         vec_cases.size(), path, skipped, bad);
+  printf("[vdot-vectors] run with -O %zu to execute every case exactly once\n",
+         vec_cases.size());
+  if (vec_cases.empty()) { printf("[vdot-vectors] no runnable case, abort\n"); exit(1); }
+  vec_mode = true;
+}
+
 TestDriver::~TestDriver() {
 }
 
