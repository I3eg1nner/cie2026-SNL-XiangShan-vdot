diff --git a/src/isa/riscv64/instr/rvv/vdot.c b/src/isa/riscv64/instr/rvv/vdot.c
new file mode 100644
index 0000000..9811a84
--- /dev/null
+++ b/src/isa/riscv64/instr/rvv/vdot.c
@@ -0,0 +1,221 @@
+/***************************************************************************************
+* vdot.c —— 非标准 int8 点积指令族（Xvdot）的执行引擎
+*
+* 三条指令（均为 OPIVV：funct3 = 000，opcode = 1010111）：
+*
+*   funct6   助记符            生效 SEW   语义
+*   -------- ----------------- ---------- ----------------------------------------
+*   111001   vdot.vv    vd,vs2,vs1   8     vd.u32[0]  = Σ_{i∈active} sext32(vs2.i8[i])*sext32(vs1.i8[i])
+*   111010   vdotacc.vv vd,vs2,vs1   8     vd.u32[0] += Σ ...                （vd 作为第三源）
+*   111011   vdot4a.vv  vd,vs2,vs1  32     ∀i∈active: vd.u32[i] += Σ_{j<4} sext32(vs2.i8[4i+j])*sext32(vs1.i8[4i+j])
+*
+* 设计原则：vl / vstart / vm / vta / vma 全部沿用 NEMU 既有框架，不另起炉灶。
+*   - vdot / vdotacc 是归约形态，整体结构对照 reduction_instr()
+*     （vcompute_impl.c:1529）：vector_reduction_check → check_vstart_exception
+*     → check_vstart_ignore → 主循环 → set_vreg_tail → 只写元素 0。
+*   - vdot4a 是逐元素形态，整体结构对照 arithmetic_instr()
+*     （vcompute_impl.c:488）：vector_vvv_check → check_vstart_exception
+*     → check_vstart_ignore → 主循环（含 vma 处理）→ tail 循环（vta）→ 清 vstart。
+*     arithmetic_instr() 在 vcompute_impl.c:544 对**每一条**标准向量算术指令都
+*     调用 check_vstart_exception()，vdot4a 与之保持一致（裁定 S-7'）。
+*
+* 溢出：int8×int8 ∈ [-16256, +16384]，16 项求和 |Σ| ≤ 262144 < 2^31，
+* 故 vdot.vv 不可能溢出、无需饱和；vdotacc / vdot4a 的累加按 2^32 模回绕
+* （由 set_vreg 在 vsew=2 时截断到 32 位自然完成），不置 vxsat。
+***************************************************************************************/
+
+#include <common.h>
+#ifdef CONFIG_RVV
+#ifdef CONFIG_CUSTOM_XVDOT
+
+#include "vcompute_impl.h"
+#include "vcommon.h"
+#include <cpu/cpu.h>
+
+#undef s0
+#undef s1
+#define s0 (&tmp_reg[0])
+#define s1 (&tmp_reg[1])
+
+/* 目的元素宽度恒为 32 位 → vsew 编码 2 */
+#define VDOT_DEST_VSEW 2
+/* 源元素宽度恒为 8 位 → vsew 编码 0 */
+#define VDOT_SRC_VSEW  0
+
+/* ---------------------------------------------------------------------------
+ * 合法性检查
+ *
+ * 归约形态复用 vector_reduction_check()（vcompute_impl.c:464，内部做
+ * require_vector(true) + require_aligned(vs2)）；逐元素形态复用
+ * vector_vvv_check()（vcompute_impl.c:407，内部额外做 require_vm()）。
+ * 在此之上追加本指令族特有的两条约束：
+ *   1) vtype.vsew 必须与指令要求一致，否则 Illegal Instruction；
+ *   2) 本版本固定 LMUL = 1（总体方案裁定 S-6），其余 vlmul 取值视为保留；
+ *   3) vstart 超出当前 SEW 的最大元素下标 -> Illegal Instruction（裁定 S-9）。
+ * 另有「vstart != 0 -> Illegal Instruction」一条，三条指令统一适用
+ * （vdot/vdotacc 依裁定 S-1，vdot4a 依裁定 S-7'），由各自的执行函数在
+ * check_vstart_ignore() 之前调用 check_vstart_exception() 完成 —— 调用位置
+ * 与 NEMU 既有框架 reduction_instr() / arithmetic_instr() 完全一致。
+ * ------------------------------------------------------------------------ */
+static void vdot_check(Decode *s, int opcode) {
+  if (opcode == VDOT4A) {
+    vector_vvv_check(s, true);
+    if (vtype->vsew != VDOT_DEST_VSEW) {
+      longjmp_exception(EX_II);
+    }
+  } else {
+    vector_reduction_check(s, 0);
+    if (vtype->vsew != VDOT_SRC_VSEW) {
+      longjmp_exception(EX_II);
+    }
+  }
+  if (vtype->vlmul != 0) {   // 仅支持 LMUL = 1
+    longjmp_exception(EX_II);
+  }
+  // 裁定 S-9：vstart 超出当前 SEW 的最大元素下标属 reserved
+  // （RVV 1.0 §3.7，并采纳其 NOTE 中"建议实现 trap"的意见）。
+  // vdot/vdotacc 的 VLMAX = 16，vdot4a 的 VLMAX = 4。
+  if (vstart->val + 1 > (uint64_t)get_vlen_max(vtype->vsew, vtype->vlmul, 0)) {
+    longjmp_exception(EX_II);
+  }
+}
+
+/* 取第 idx 个 int8 源元素并符号扩展，返回 int64。
+ * get_vreg(..., SIGNED, ...) 本身就按 (int64_t)(int8_t) 扩展，这里再调一次
+ * rtl_sext 与 reduction_instr()/arithmetic_instr() 的写法保持一致。 */
+static inline int64_t vdot_get_i8(Decode *s, uint64_t reg, int idx, rtlreg_t *tmp) {
+  get_vreg(reg, idx, tmp, VDOT_SRC_VSEW, vtype->vlmul, SIGNED, 0);
+  rtl_sext(s, tmp, tmp, 1 << VDOT_SRC_VSEW);
+  return (int64_t)*tmp;
+}
+
+/* ---------------------------------------------------------------------------
+ * vdot.vv / vdotacc.vv —— 四倍宽全向量归约（SEW=8 → 目的 EEW=32）
+ *
+ * 结构逐条对照 reduction_instr()（vcompute_impl.c:1529-1572）：
+ *   - check_vstart_exception()：vstart != 0 → Illegal Instruction（裁定 S-1，
+ *     RVV 1.0 §14「Vector reduction operations raise an illegal instruction
+ *     exception if vstart is non-zero」）；
+ *   - check_vstart_ignore()：vstart >= vl（含 vl == 0）→ 连 tail 都不写（S-5）；
+ *   - 掩码为 0 的源元素直接 continue，排除出求和（§14 / S-2：归约无 inactive
+ *     目的元素，故 vma 不参与）；
+ *   - vta=1 时先 set_vreg_tail() 把整个目的寄存器置全 1，再写元素 0，
+ *     净效果为「元素 1..3 全 1（tail，EEW=32，裁定 S-3）+ 元素 0 为结果」。
+ * ------------------------------------------------------------------------ */
+static void vdot_reduce(Decode *s, int accumulate) {
+  check_vstart_exception(s);
+  if (check_vstart_ignore(s)) {
+    vp_set_dirty();
+    return;
+  }
+
+  /* 累加器：在 64 位上累加，写回时由 set_vreg 截断到 32 位（模 2^32 回绕）。
+   * vdotacc 把 vd 作为第三源读取，必须在 set_vreg_tail() 之前读。 */
+  uint64_t acc = 0;
+  if (accumulate) {
+    get_vreg(id_dest->reg, 0, s1, VDOT_DEST_VSEW, vtype->vlmul, UNSIGNED, 0);
+    acc = *s1;
+  }
+
+  for (word_t idx = vstart->val; idx < vl->val; idx++) {
+    rtlreg_t mask = get_mask(0, idx);
+    if (s->vm == 0 && mask == 0) {
+      continue;
+    }
+    int64_t a = vdot_get_i8(s, id_src2->reg, idx, s0);
+    int64_t b = vdot_get_i8(s, id_src->reg,  idx, s1);
+    acc += (uint64_t)(a * b);
+  }
+
+  if (RVV_AGNOSTIC) {
+    if (vtype->vta && vl->val != 0) set_vreg_tail(id_dest->reg);
+  }
+  if (vl->val != 0) {
+    set_vreg(id_dest->reg, 0, acc, VDOT_DEST_VSEW, vtype->vlmul, 0);
+  }
+  vp_set_dirty();
+  vstart->val = 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * vdot4a.vv —— 分组点积累加（SEW=32），逐元素指令
+ *
+ * 结构逐条对照 arithmetic_instr()（vcompute_impl.c:488-1011）：
+ *   - check_vstart_exception()：vstart != 0 → Illegal Instruction（裁定 S-7'）。
+ *     这一条与归约形态的依据不同：vdot4a 是逐元素指令，RVV 1.0 并不要求它禁止
+ *     非零 vstart；禁止的理由是**平台约束优先原则** —— 目标微架构昆明湖 V2 的
+ *     向量算术通路不支持从非零 vstart 恢复执行，其译码级公共判据
+ *     `vstartIllegal = isVArith && (vstart =/= 0)`（XiangShan
+ *     src/main/scala/xiangshan/backend/decode/VecExceptionGen.scala）对所有
+ *     向量算术指令无条件生效。自定义指令的 ISA 语义不应宽于宿主微架构的实际
+ *     能力，因此让 ISA 向微架构收敛，而不是为一条自定义指令去放宽上游的公共
+ *     判据。本冲突由 NEMU <-> RTL 协同仿真发现：原裁定 S-7 下 NEMU 正常执行而
+ *     香山判非法，在全核 difftest 上必然 mismatch。修订后三条 vdot 指令的
+ *     vstart 行为完全一致。
+ *     注：arithmetic_instr()（vcompute_impl.c:544）对每一条标准向量算术指令
+ *     同样调用 check_vstart_exception()，故本调用不是特例，而是回归常规。
+ *   - check_vstart_ignore()：vstart >= vl → 连 tail 都不写；
+ *   - 主循环从 vstart 开始（S-7' 之后此处 vstart 恒为 0，保留写法与上游一致）；
+ *   - mask == 0 时按 vma 决定「写全 1」或「保持不变」，掩码粒度是 32 位元素；
+ *   - tail 循环把 [vl, vlmax) 写全 1（vta=1）；
+ *   - 结尾用 vcsr_write(IDXVSTART, 0) 清 vstart。
+ * 子元素定位：element i 的第 j 个 int8 位于字节 4i+j（寄存器内小端）——
+ * 裁定 S-7 的这一部分未被 S-7' 修订，仍然有效。
+ * ------------------------------------------------------------------------ */
+static void vdot4a_exec(Decode *s) {
+  check_vstart_exception(s);   // 裁定 S-7'：vstart != 0 -> Illegal Instruction
+  if (check_vstart_ignore(s)) {
+    vp_set_dirty();
+    return;
+  }
+
+  for (word_t idx = vstart->val; idx < vl->val; idx++) {
+    rtlreg_t mask = get_mask(0, idx);
+    if (s->vm == 0 && mask == 0) {
+      if (RVV_AGNOSTIC && vtype->vma) {
+        *s1 = (uint64_t)-1;
+        set_vreg(id_dest->reg, idx, *s1, VDOT_DEST_VSEW, vtype->vlmul, 1);
+      }
+      continue;
+    }
+
+    /* vd 作为第三源读取（复用 vmacc.vv 的三源通路写法） */
+    get_vreg(id_dest->reg, idx, s1, VDOT_DEST_VSEW, vtype->vlmul, UNSIGNED, 1);
+    uint64_t acc = *s1;
+    for (int j = 0; j < 4; j++) {
+      int bidx = (int)(idx * 4) + j;
+      int64_t a = vdot_get_i8(s, id_src2->reg, bidx, s0);
+      int64_t b = vdot_get_i8(s, id_src->reg,  bidx, s1);
+      acc += (uint64_t)(a * b);
+    }
+    *s1 = acc;
+    set_vreg(id_dest->reg, idx, *s1, VDOT_DEST_VSEW, vtype->vlmul, 1);
+  }
+
+  if (RVV_AGNOSTIC) {
+    if (vtype->vta) {
+      int vlmax = get_vlen_max(vtype->vsew, vtype->vlmul, 0);
+      for (int idx = (int)vl->val; idx < vlmax; idx++) {
+        *s1 = (uint64_t)-1;
+        set_vreg(id_dest->reg, idx, *s1, VDOT_DEST_VSEW, vtype->vlmul, 1);
+      }
+    }
+  }
+
+  rtl_li(s, s0, 0);
+  vcsr_write(IDXVSTART, s0);
+  vp_set_dirty();
+}
+
+void vdot_instr(int opcode, Decode *s) {
+  vdot_check(s, opcode);
+  switch (opcode) {
+    case VDOT:    vdot_reduce(s, 0); break;
+    case VDOTACC: vdot_reduce(s, 1); break;
+    case VDOT4A:  vdot4a_exec(s);    break;
+    default:      longjmp_exception(EX_II);
+  }
+}
+
+#endif // CONFIG_CUSTOM_XVDOT
+#endif // CONFIG_RVV
